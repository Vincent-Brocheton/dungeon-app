rules_version = '2';

// Modèle : users/{uid}/characters/{characterId}
// Un utilisateur (anonyme ou lié) ne voit et n'écrit que son propre sous-arbre.
// admins/{uid} : l'existence du document = rôle admin (lecture seule sur les personnages).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validCharacter() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion', 'name', 'updatedAt'])
        && d.schemaVersion is int && d.schemaVersion >= 1
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.updatedAt is timestamp
        && (!('deletedAt' in d) || d.deletedAt == null || d.deletedAt is timestamp)
        && (!('level' in d) || (d.level is int && d.level >= 1 && d.level <= 20));
    }

    // Joueur de la table (tableMembers/{uid} existe).
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/tableMembers/$(request.auth.uid));
    }

    function validTablePublic() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'world', 'cadence', 'nextSessionWhen',
          'nextSessionWhere', 'nextSessionNote', 'updatedAt'])
        && d.name is string && d.name.size() <= 120
        && d.world is string && d.world.size() <= 500
        && d.cadence is string && d.cadence.size() <= 200
        && d.nextSessionWhen is string && d.nextSessionWhen.size() <= 200
        && d.nextSessionWhere is string && d.nextSessionWhere.size() <= 200
        && d.nextSessionNote is string && d.nextSessionNote.size() <= 2000
        && d.updatedAt is timestamp;
    }

    function validInvite() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tableName', 'tableWorld', 'createdAt'])
        && d.tableName is string && d.tableName.size() <= 120
        && d.tableWorld is string && d.tableWorld.size() <= 500
        && d.createdAt is timestamp;
    }

    // Le code d'invitation doit exister à l'entrée ; un joueur déjà membre
    // peut changer de personnage même si son invitation a été révoquée.
    function validMember() {
      let d = request.resource.data;
      return d.keys().hasOnly(['inviteCode', 'joinedAt', 'characterId',
          'characterName', 'characterSummary'])
        && d.inviteCode is string && d.inviteCode.size() > 0
        && d.inviteCode.size() <= 32
        && d.joinedAt is timestamp
        && (d.characterId == null
          || (d.characterId is string && d.characterId.size() <= 128))
        && d.characterName is string && d.characterName.size() <= 80
        && d.characterSummary is string && d.characterSummary.size() <= 160
        && (exists(/databases/$(database)/documents/invites/$(d.inviteCode))
          || (resource != null && resource.data.inviteCode == d.inviteCode));
    }

    // L'auteur et la date de création ne changent jamais (vérifié au
    // match) ; le statut ne vaut que pour une quête.
    function validChronicle() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'status', 'title', 'text', 'authorUid',
          'authorName', 'createdAt'])
        && d.kind in ['quest', 'encounter', 'note']
        && d.status is string
        && (d.kind == 'quest'
          ? d.status in ['ongoing', 'done', 'failed']
          : d.status == '')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.text is string && d.text.size() <= 4000
        && d.authorUid is string
        && d.authorName is string && d.authorName.size() <= 80
        && d.createdAt is timestamp;
    }

    function validTreasuryMovement() {
      let d = request.resource.data;
      return d.keys().hasOnly(['label', 'coin', 'amount', 'authorUid',
          'createdAt'])
        && d.label is string && d.label.size() > 0 && d.label.size() <= 120
        && d.coin in ['gold', 'silver', 'copper']
        && d.amount is int && d.amount != 0
        && d.amount >= -1000000 && d.amount <= 1000000
        && d.authorUid == request.auth.uid
        && d.createdAt is timestamp;
    }

    function validTreasuryItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'note', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.note is string && d.note.size() <= 500
        && d.createdAt is timestamp;
    }

    function validRoll() {
      let d = request.resource.data;
      return d.keys().hasOnly(['characterId', 'characterName', 'label',
          'detail', 'total', 'inspired', 'createdAt'])
        && d.characterId is string && d.characterId.size() > 0
        && d.characterId.size() <= 128
        && d.characterName is string && d.characterName.size() <= 80
        && d.label is string && d.label.size() <= 200
        && d.detail is string && d.detail.size() <= 300
        && d.total is int
        && d.inspired is bool
        && d.createdAt is timestamp;
    }

    function validNote() {
      let d = request.resource.data;
      return d.keys().hasOnly(['characterId', 'text', 'createdAt'])
        && d.characterId is string && d.characterId.size() > 0
        && d.characterId.size() <= 128
        && d.text is string && d.text.size() > 0 && d.text.size() <= 4000
        && d.createdAt is timestamp;
    }

    function validSpecies() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.updatedAt is timestamp;
    }

    function validSubspecies() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'parentSpeciesId', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.parentSpeciesId is string && d.parentSpeciesId.size() > 0
        && d.updatedAt is timestamp;
    }

    function validSubclass() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'parentClassId', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.parentClassId is string && d.parentClassId.size() > 0
        && d.updatedAt is timestamp;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // Contenu de règles édité par un admin (espèces, puis classes/dons/sorts
    // à mesure qu'ils seront bâtis) : tout utilisateur authentifié lit (la
    // création de personnage en aura besoin), seul un admin écrit.
    match /content/{document=**} {
      allow read: if request.auth != null;
    }

    match /content/species/items/{speciesId} {
      allow write: if isAdmin() && validSpecies();
    }

    match /content/subspecies/items/{subspeciesId} {
      allow write: if isAdmin() && validSubspecies();
    }

    // validSpecies() ne vérifie que name + updatedAt : générique, réutilisée
    // ici (pas de champ propre aux sorts à valider côté règles).
    match /content/spells/items/{spellId} {
      allow write: if isAdmin() && validSpecies();
    }

    // Même raison : pas de champ propre aux dons à valider côté règles.
    match /content/feats/items/{featId} {
      allow write: if isAdmin() && validSpecies();
    }

    // Idem pour les classes.
    match /content/classes/items/{classId} {
      allow write: if isAdmin() && validSpecies();
    }

    match /content/subclasses/items/{subclassId} {
      allow write: if isAdmin() && validSubclass();
    }

    // Comme les espèces : name + updatedAt suffisent côté règles.
    match /content/backgrounds/items/{backgroundId} {
      allow write: if isAdmin() && validSpecies();
    }

    // Idem pour les manifestations occultes.
    match /content/invocations/items/{invocationId} {
      allow write: if isAdmin() && validSpecies();
    }

    // Idem pour les monstres.
    match /content/monsters/items/{monsterId} {
      allow write: if isAdmin() && validSpecies();
    }

    // PNJ : fiches de scène du MJ, hors de content/ — ni lisibles ni
    // modifiables par les joueurs.
    match /npcs/{npcId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && validSpecies();
    }

    // Infos de la table visibles des joueurs (sans le journal du MJ).
    match /tablePublic/{docId} {
      allow read: if isAdmin() || isMember();
      allow write: if isAdmin() && validTablePublic();
    }

    // Invitations : le code est le secret, lu un par un (jamais listé hors
    // MJ) ; seul le MJ en crée ou en révoque.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if isAdmin() && validInvite();
      allow delete: if isAdmin();
    }

    // Joueurs de la table : chacun crée ou met à jour sa propre adhésion
    // avec un code valide ; les membres et le MJ voient la liste ; on quitte
    // soi-même, ou le MJ retire.
    match /tableMembers/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isMember();
      allow create, update: if isOwner(uid) && validMember();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Chronique partagée : membres et MJ lisent et publient en leur nom ;
    // l'auteur (encore membre) ou le MJ modifie et supprime.
    match /tableChronicle/{entryId} {
      allow read: if isAdmin() || isMember();
      allow create: if (isAdmin() || isMember()) && validChronicle()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if (isAdmin()
          || (isMember() && resource.data.authorUid == request.auth.uid))
        && validChronicle()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin()
        || (isMember() && resource.data.authorUid == request.auth.uid);
    }

    // Réserve du groupe : registre de mouvements jamais modifiés. Un joueur
    // ne fait que verser (montant positif) ; le MJ ajuste dans les deux sens.
    match /treasuryMovements/{movementId} {
      allow read: if isAdmin() || isMember();
      allow create: if validTreasuryMovement()
        && (isAdmin() || (isMember() && request.resource.data.amount > 0));
    }

    // Objets communs : lus par la table, gérés par le MJ.
    match /treasuryItems/{itemId} {
      allow read: if isAdmin() || isMember();
      allow create: if isAdmin() && validTreasuryItem();
      allow delete: if isAdmin();
    }

    // Table du MJ (paramètres, journal privé) : réservée aux admins.
    match /table/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && validSpecies();
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /characters/{characterId} {
        allow read: if isOwner(uid) || isAdmin();
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCharacter();
      }

      // Notes de session privées : le propriétaire seul, jamais le MJ (hors
      // du wildcard characters ci-dessous, volontairement).
      match /notes/{noteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validNote();
      }

      // Historique des jets : le propriétaire écrit, le MJ lit (wildcard
      // ci-dessous) ; jamais modifié.
      match /rolls/{rollId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validRoll();
      }
    }

    // Le bloc imbriqué ci-dessus couvre les gets et les requêtes scopées à
    // un seul utilisateur, mais Firestore exige ce wildcard récursif pour
    // valider une requête collectionGroup('characters') (admin uniquement,
    // toujours en lecture seule) : sans lui, la requête cross-utilisateurs
    // échoue en PERMISSION_DENIED même quand isAdmin() est vrai.
    match /{path=**}/characters/{characterId} {
      allow read: if isAdmin();
    }

    // Même raison pour collectionGroup('rolls') : historique de la table, MJ.
    match /{path=**}/rolls/{rollId} {
      allow read: if isAdmin();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
